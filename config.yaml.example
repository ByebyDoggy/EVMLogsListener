chains:
  - name: ethereum
    chain_id: 1
    poll_interval: 30
    rpc_nodes:
      - url: "${ALCHEMY_ETH_URL}"
        priority: 1
        type: alchemy
        rate_limit:
          requests_per_second: 10
          burst: 20
      - url: "${INFURA_ETH_URL}"
        priority: 2
        type: infura
        rate_limit:
          requests_per_second: 10
          burst: 20
      - url: "https://eth.public-rpc.com"
        priority: 3
        type: public
        rate_limit:
          requests_per_second: 1
          burst: 5

  - name: bsc
    chain_id: 56
    poll_interval: 30
    rpc_nodes:
      - url: "${BSC_RPC_URL}"
        priority: 1
        type: paid
        rate_limit:
          requests_per_second: 5
          burst: 10

  - name: polygon
    chain_id: 137
    poll_interval: 30
    # --- Option: apipool-server auto-load (v1.0.5+) ---
    # Instead of hardcoding URLs, login to apipool-server and
    # auto-fetch the key list at startup.
    # apipool_server:
    #   service_url: "http://localhost:8000"
    #   client_type: "polygon-rpc"
    #   username: "alice"
    #   password: "${APIPOOL_PASSWORD}"
    rpc_nodes:
      - url: "${POLYGON_RPC_URL}"
        priority: 1
        type: paid
        rate_limit:
          requests_per_second: 5
          burst: 10

cache:
  max_size: 10000

api:
  host: "0.0.0.0"
  port: 8080

log:
  level: INFO
  format: json
  output: stdout

health:
  enabled: true
  endpoint: /health

alert_processor:
  enabled: false
  url: "http://localhost:8000"
  push_interval_seconds: 5
  batch_size: 200
  max_payload_mb: 10
  retry_attempts: 3
  retry_base_delay_sec: 1
  timeout_seconds: 10
  reconnect_check_on_startup: true
  replay_endpoint: "/ingest/logs/replay"

# --- Log Recorder: save logs to local SQLite storage ---
# Enable in realtime or backtest mode to record all incoming logs.
# Recorded data can later be replayed via the `replay` config.
recorder:
  enabled: false                      # Set true to enable recording
  directory: "./recordings"           # Directory for the SQLite database
  # db_filename: "logs.db"            # SQLite filename (default: logs.db)

# --- Log Replay: load logs from local SQLite storage instead of RPC ---
# Only used in backtest mode. When configured, backtest will read logs
# from a local database instead of querying RPC nodes.
# replay:
#   file_path: "./recordings/logs.db"   # SQLite database path
#   # OR directory mode (auto-discovers .db files):
#   # directory: "./recordings"
#   from_block: null                    # Optional block range filter
#   to_block: null
#   blocks_per_batch: 2                 # Number of blocks per replay batch (default: 2)
#   batch_interval_seconds: 5.0         # Seconds to wait between batches (default: 5.0)

# --- Backtest Startup Config ---
# Only used in backtest mode. When from_block/to_block are set, a backtest
# task is automatically submitted on startup for each configured chain.
# Can also be set via CLI: --from-block and --to-block (CLI overrides config).
backtest:
  from_block: null                   # Starting block (inclusive), null = no auto-start
  to_block: null                     # Ending block (inclusive), null = no auto-start
  batch_size: 1000                   # Blocks per batch query
